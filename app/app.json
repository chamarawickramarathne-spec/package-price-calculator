{
  "expo": {
    "name": "Package Price Calculator",
    "slug": "package-price-calculator",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.chamara.ppackagepricecalculator",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": []
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 512
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3d0a7203-ad3a-429d-ba95-fde036a1f232"
      }
    },
    "owner": "kogn12"
  }
}
